        </mxCell>
        <mxCell id="cell_ERD_163" style="text;html=0;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#D7E1EB;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" parent="1" vertex="1" value="Files: validated type, &lt;= 10 MiB, outside webroot; only valid status + authorized attached message.">
