        </mxCell>
        <mxCell id="cell_ERD_160" style="text;html=0;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#D7E1EB;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" parent="1" vertex="1" value="Argon2id password hashes only. Sessions: 15-minute inactivity timeout and revocation.">
          <mxGeometry x="691.73" y="1808" width="716.53" height="25.12" as="geometry"/>
        </mxCell>
        <mxCell id="cell_ERD_161" style="text;html=0;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#D7E1EB;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" parent="1" vertex="1" value="Membership: joined_at / left_at limit history; departed members cannot access or receive events.">
