        </mxCell>
        <mxCell id="cell_ERD_164" style="text;html=0;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#D7E1EB;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" parent="1" vertex="1" value="Audit logs: append-only and free of passwords, tokens, and keys. App DB role has least privilege.">
