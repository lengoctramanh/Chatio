        <mxCell id="6Hh5XLUoY-0cQtoioQnZ-207" parent="6Hh5XLUoY-0cQtoioQnZ-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;p&gt;SECURITY &amp;amp; DATABASE CONSTRAINTS&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;Passwords: Argon2id hashes only, never plaintext.&lt;/li&gt;&lt;li&gt;Sessions: 15-minute inactivity timeout; revoked sessions denied.&lt;/li&gt;&lt;li&gt;Members: access is restricted by joined_at and left_at.&lt;/li&gt;&lt;li&gt;Messages: UNIQUE(sender_id, client_msg_id).&lt;/li&gt;&lt;li&gt;Messages: maximum 4,000 characters, plain text.&lt;/li&gt;&lt;li&gt;Files: PNG/JPEG/PDF/TXT, maximum 10 MiB, outside webroot.&lt;/li&gt;&lt;li&gt;File downloads: verify session and message access rights.&lt;/li&gt;&lt;li&gt;Audit logs: append-only; do not store passwords or tokens.&lt;/li&gt;&lt;li&gt;Database: application account uses least privileges.&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
