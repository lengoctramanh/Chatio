  <diagram name="Trang-1" id="UrAMWYt27LzTRy_98_9H">
    <mxGraphModel dx="3135" dy="1677" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
