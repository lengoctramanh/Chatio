  <diagram id="ch_04RevokeSession" name="04_Revoke_Session">
    <mxGraphModel dx="2580" dy="5096" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2580" pageHeight="5096" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="group_04_Revoke_Session" label="" mermaidData="{&quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as Nguoi dung\n    actor ADM as Quan tri vien\n    participant C as Frontend (React)\n    participant A as Backend (Express.js)\n    participant DB as Database (PostgreSQL)\n    participant S as Socket.IO Server\n\n    alt Nguoi dung dang xuat\n        U-&gt;&gt;C: Nhan Dang xuat\n        C-&gt;&gt;A: POST /api/auth/logout + CSRF\n        A-&gt;&gt;A: Xac minh CSRF token\n        alt CSRF khong hop le\n            A--&gt;&gt;C: 403 Forbidden, khong xoa cookie\n        else CSRF hop le\n            A-&gt;&gt;DB: Kiem tra session hien tai\n            DB--&gt;&gt;A: Trang thai session\n            alt Session khong ton tai hoac het han\n                A--&gt;&gt;C: Xoa cookie + 204 No Content\n            else Session hop le\n                A-&gt;&gt;DB: Thu hoi session va ghi audit log\n                DB--&gt;&gt;A: Transaction COMMIT\n                A-&gt;&gt;S: Ngat socket cua session bi thu hoi\n                A--&gt;&gt;C: Xoa cookie va tra ket qua\n                C--&gt;&gt;U: Chuyen ve trang dang nhap\n            end\n        end\n\n    else Nguoi dung doi mat khau\n        U-&gt;&gt;C: Nhap mat khau cu va moi\n        C-&gt;&gt;A: POST /api/auth/change-password + CSRF\n        A-&gt;&gt;A: Xac minh CSRF token\n        alt CSRF khong hop le\n            A--&gt;&gt;C: 403 Forbidden, khong thay doi mat khau\n        else CSRF hop le\n            A-&gt;&gt;DB: Kiem tra session va tai khoan\n            DB--&gt;&gt;A: Thong tin tai khoan\n            alt Session khong hop le\n                A--&gt;&gt;C: 401 Unauthorized\n            else Session hop le\n                A-&gt;&gt;A: Xac minh mat khau cu\n                A-&gt;&gt;A: Kiem tra mat khau moi it nhat 15 ky tu\n                alt Mat khau cu khong dung\n                    A-&gt;&gt;DB: Ghi audit log PASSWORD_CHANGE_FAILED\n                    A--&gt;&gt;C: 401 Unauthorized\n                else Mat khau moi khong hop le\n                    A--&gt;&gt;C: 400 Bad Request + tra loi validation\n                else Xac thuc va du lieu hop le\n                    A-&gt;&gt;A: Bam mat khau moi bang Argon2id\n                    A-&gt;&gt;DB: Cap nhat hash va thu hoi ALL sessions\n                    A-&gt;&gt;DB: Ghi audit log\n                    DB--&gt;&gt;A: Transaction COMMIT\n                    A-&gt;&gt;S: Ngat tat ca socket cua user\n                    A--&gt;&gt;C: Xoa cookie va yeu cau dang nhap lai\n                    C--&gt;&gt;U: Hien thi trang dang nhap\n                end\n            end\n        end\n\n    else Quan tri vien khoa tai khoan\n        ADM-&gt;&gt;C: Chon tai khoan can khoa\n        C-&gt;&gt;A: POST /api/admin/users/:id/lock + CSRF\n        A-&gt;&gt;A: Xac minh CSRF token\n        alt CSRF khong hop le\n            A--&gt;&gt;C: 403 Forbidden, khong khoa tai khoan\n        else CSRF hop le\n            A-&gt;&gt;DB: Kiem tra session, vai tro ADMIN va tai khoan can khoa\n            DB--&gt;&gt;A: Ket qua phan quyen\n            alt Khong co quyen\n                A-&gt;&gt;DB: Ghi audit log tu choi\n                A--&gt;&gt;C: 403 Forbidden\n            else Target khong ton tai\n                A--&gt;&gt;C: 404 Not Found\n            else Target da bi khoa\n                A--&gt;&gt;C: 200 OK hoac 204 No Content\n            else Admin hop le va target ton tai\n                A-&gt;&gt;DB: Khoa user va thu hoi ALL sessions\n                A-&gt;&gt;DB: Ghi audit log\n                DB--&gt;&gt;A: Transaction COMMIT\n                A-&gt;&gt;S: Ngat tat ca socket cua user bi khoa\n                A--&gt;&gt;C: Khoa tai khoan thanh cong\n                C--&gt;&gt;ADM: Cap nhat trang thai tai khoan\n            end\n        end\n    end\n\n    Note over A,S: Moi API va Socket.IO event phai kiem tra session\n    Note over A,S: Session revoked khong duoc tiep tuc hoat dong\n    Note over ADM,S: Admin reset: kiem tra quyen ADMIN, CSRF va xac minh yeu cau noi bo\n    Note over A,S: Cap nhat password_hash, must_change_password=true, revoke ALL sessions va audit, COMMIT, ngat Socket.IO\n&quot;, &quot;config&quot;: {&quot;theme&quot;: &quot;dark&quot;}, &quot;version&quot;: &quot;final-readable&quot;}">
          <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;" vertex="1" parent="1">
            <mxGeometry x="0" y="0" width="2580" height="5096" as="geometry"/>
          </mxCell>
        </UserObject>
