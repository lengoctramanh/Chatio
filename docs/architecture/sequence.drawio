  <diagram id="ch_03DownloadFile" name="03_Download_File">
    <mxGraphModel dx="2140" dy="2485" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2140" pageHeight="2485" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="group_03_Download_File" label="" mermaidData="{&quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as Nguoi tai file\n    participant C as Frontend (React)\n    participant A as Backend (Express.js)\n    participant DB as Database (PostgreSQL)\n    participant F as Private File Storage\n\n    U-&gt;&gt;C: Nhan nut Tai file\n    C-&gt;&gt;A: GET /api/files/:fileId\n\n    A-&gt;&gt;DB: Kiem tra session va trang thai user\n    DB--&gt;&gt;A: Ket qua xac thuc\n\n    alt Session khong hop le hoac user bi khoa\n        A-&gt;&gt;DB: Ghi audit log tu choi\n        A--&gt;&gt;C: 401 Unauthorized\n        C--&gt;&gt;U: Yeu cau dang nhap lai\n\n    else Session hop le\n        A-&gt;&gt;DB: Tim metadata va trang thai file theo fileId\n        DB--&gt;&gt;A: File metadata, message_id, storage_key va status\n\n        alt File khong ton tai hoac status không hợp lệ\n            A--&gt;&gt;C: 404 Not Found\n            C--&gt;&gt;U: Khong tim thay file\n\n        else File ton tai va status hop le\n            A-&gt;&gt;DB: Lay message va conversation\n            DB--&gt;&gt;A: Loai hoi thoai va messages.created_at\n\n            A-&gt;&gt;DB: Kiem tra quyen tai file theo membership va moc thoi gian\n            DB--&gt;&gt;A: Ket qua phan quyen\n\n            alt Khong co quyen xem tin gan file\n                A-&gt;&gt;DB: Ghi audit log FILE_ACCESS_DENIED\n                A--&gt;&gt;C: 404 Not Found\n                C--&gt;&gt;U: Khong the tai file\n\n            else Co quyen tai file\n                A-&gt;&gt;F: Doc file bang storage_key noi bo\n\n                alt File vat ly khong con\n                    F--&gt;&gt;A: File missing\n                    A--&gt;&gt;C: 404 File unavailable\n                    C--&gt;&gt;U: File khong kha dung\n\n                else File ton tai\n                    F--&gt;&gt;A: File stream\n                    A--&gt;&gt;C: 200 File attachment\n                    C--&gt;&gt;U: Tai file thanh cong\n                end\n            end\n        end\n    end\n&quot;, &quot;config&quot;: {&quot;theme&quot;: &quot;dark&quot;}, &quot;version&quot;: &quot;final-readable&quot;}">
          <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;" vertex="1" parent="1">
            <mxGeometry x="0" y="0" width="2140" height="2485" as="geometry"/>
          </mxCell>
        </UserObject>
