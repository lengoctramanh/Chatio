  <diagram id="04C41vCPgKVtFBp0Q_mQ" name="02_Send_Group_Message">
    <mxGraphModel dx="1231" dy="795" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as Nguoi gui\n    participant C as React Client\n    participant S as Express + Socket.IO\n    participant DB as PostgreSQL\n    actor R as Thanh vien nhom\n\n    U-&gt;&gt;C: Nhap va gui tin nhan\n    C-&gt;&gt;C: Tao client_msg_id duy nhat\n    C-&gt;&gt;S: Emit message:send\n\n    S-&gt;&gt;DB: Kiem tra session va user\n    DB--&gt;&gt;S: Trang thai phien va tai khoan\n\n    alt Session khong hop le\n        S--&gt;&gt;C: Tu choi va yeu cau dang nhap lai\n    else Session hop le\n        S-&gt;&gt;S: Kiem tra CSRF/Origin va rate limit\n        S-&gt;&gt;S: Kiem tra noi dung toi da 4000 ky tu\n\n        alt Yeu cau khong hop le\n            S--&gt;&gt;C: Tu choi yeu cau\n        else Yeu cau hop le\n            S-&gt;&gt;DB: Kiem tra thanh vien hien tai\n            DB--&gt;&gt;S: Membership va joined_at left_at\n\n            alt Khong co quyen gui\n                S-&gt;&gt;DB: Ghi audit log tu choi\n                S--&gt;&gt;C: Loi FORBIDDEN\n            else Co quyen gui\n                S-&gt;&gt;DB: BEGIN transaction\n                S-&gt;&gt;DB: Kiem tra client_msg_id\n\n                alt Tin nhan da ton tai\n                    DB--&gt;&gt;S: Tra ve tin da luu\n                    S-&gt;&gt;DB: COMMIT\n                    S--&gt;&gt;C: ACK tin nhan cu\n                else Tin nhan moi\n                    S-&gt;&gt;DB: Kiem tra lai quyen va INSERT message\n                    DB--&gt;&gt;S: Tin nhan da luu\n                    S-&gt;&gt;DB: COMMIT\n                    DB--&gt;&gt;S: Thanh cong\n                    S--&gt;&gt;C: ACK gui thanh cong\n                    S-&gt;&gt;DB: Lay nguoi nhan con quyen\n                    DB--&gt;&gt;S: Danh sach thanh vien hop le\n                    S-&gt;&gt;R: Emit message:new\n                end\n            end\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vv9PP5Ui-bIeL-6GGJe6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
