  <diagram id="aWSAsxBsTRVBHKDvw16o" name="03_Download_File">
    <mxGraphModel dx="1481" dy="957" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as Nguoi tai file\n    participant C as React Client\n    participant A as Express Backend\n    participant DB as PostgreSQL\n    participant F as Private File Storage\n\n    U-&gt;&gt;C: Nhan nut Tai file\n    C-&gt;&gt;A: GET /api/files/:fileId\n\n    A-&gt;&gt;DB: Kiem tra session va trang thai user\n    DB--&gt;&gt;A: Ket qua xac thuc\n\n    alt Session khong hop le hoac user bi khoa\n        A-&gt;&gt;DB: Ghi audit log tu choi\n        A--&gt;&gt;C: 401 Unauthorized\n        C--&gt;&gt;U: Yeu cau dang nhap lai\n\n    else Session hop le\n        A-&gt;&gt;DB: Tim metadata file theo fileId\n        DB--&gt;&gt;A: File metadata va message_id\n\n        alt File khong ton tai\n            A--&gt;&gt;C: 404 Not Found\n            C--&gt;&gt;U: Khong tim thay file\n\n        else File ton tai\n            A-&gt;&gt;DB: Lay message va conversation\n            DB--&gt;&gt;A: Loai hoi thoai va created_at\n\n            A-&gt;&gt;DB: Kiem tra membership va moc thoi gian\n            DB--&gt;&gt;A: Ket qua phan quyen\n\n            alt Khong co quyen xem tin gan file\n                A-&gt;&gt;DB: Ghi audit log FILE_ACCESS_DENIED\n                A--&gt;&gt;C: 404 Not Found\n                C--&gt;&gt;U: Khong the tai file\n\n            else Co quyen tai file\n                A-&gt;&gt;F: Doc file bang storage_key noi bo\n\n                alt File vat ly khong con\n                    F--&gt;&gt;A: File missing\n                    A--&gt;&gt;C: 404 File unavailable\n                    C--&gt;&gt;U: File khong kha dung\n\n                else File ton tai\n                    F--&gt;&gt;A: File stream\n                    A--&gt;&gt;C: 200 File attachment\n                    C--&gt;&gt;U: Tai file thanh cong\n                end\n            end\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="oX41H_KgF6ZdRkGwSex3-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
