  <diagram id="ch_01Login" name="01_Login">
    <mxGraphModel dx="1700" dy="1922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1922" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="group_01_Login" label="" mermaidData="{&quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as User\n    participant C as Frontend (React)\n    participant A as Backend (Express.js)\n    participant DB as Database (PostgreSQL)\n\n    U-&gt;&gt;C: Nhap username va password\n    C-&gt;&gt;A: POST /api/auth/login\n    A-&gt;&gt;A: Kiem tra gioi han dang nhap\n\n    alt Vuot gioi han\n        A--&gt;&gt;C: 429 Too Many Requests\n        C--&gt;&gt;U: Thong bao thu lai sau\n    else Duoc phep thu\n        A-&gt;&gt;DB: Tim tai khoan theo username\n        DB--&gt;&gt;A: Thong tin tai khoan hoac khong tim thay\n        A-&gt;&gt;A: Xác minh mật khẩu bằng Argon2id&lt;br/&gt;và kiểm tra trạng thái tài khoản\n\n        alt Sai thong tin hoac tai khoan bi khoa\n            A-&gt;&gt;DB: Ghi audit log that bai\n            A--&gt;&gt;C: 401 Thong bao loi chung\n            C--&gt;&gt;U: Dang nhap khong thanh cong\n        else Thong tin hop le\n            A-&gt;&gt;A: Tao session token ngau nhien\n            A-&gt;&gt;DB: Lưu hash session token, userId và expiresAt\n            DB--&gt;&gt;A: Session da luu\n            A-&gt;&gt;DB: Ghi audit log thanh cong\n            A--&gt;&gt;C: 200 va cookie Secure HttpOnly SameSite\n\n            alt Phai doi mat khau lan dau\n                C--&gt;&gt;U: Chuyen den trang doi mat khau\n            else Khong can doi mat khau\n                C--&gt;&gt;U: Chuyen den trang Chat\n            end\n        end\n    end\n&quot;, &quot;config&quot;: {&quot;theme&quot;: &quot;dark&quot;}, &quot;version&quot;: &quot;final-readable&quot;}">
          <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;" vertex="1" parent="1">
            <mxGeometry x="0" y="0" width="1700" height="1922" as="geometry"/>
          </mxCell>
