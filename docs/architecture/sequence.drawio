  <diagram id="T98-sfBzwQEIXIpfVM09" name="04_Revoke_Session">
    <mxGraphModel dx="1231" dy="795" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as Nguoi dung\n    actor ADM as Quan tri vien\n    participant C as React Client\n    participant A as Express Backend\n    participant DB as PostgreSQL\n    participant S as Socket.IO Server\n\n    alt Nguoi dung dang xuat\n        U-&gt;&gt;C: Nhan Dang xuat\n        C-&gt;&gt;A: POST /api/auth/logout + CSRF\n        A-&gt;&gt;DB: Kiem tra session hien tai\n        DB--&gt;&gt;A: Trang thai session\n\n        alt Session va CSRF hop le\n            A-&gt;&gt;DB: Thu hoi session va ghi audit log\n            DB--&gt;&gt;A: Transaction COMMIT\n            A-&gt;&gt;S: Ngat socket cua session bi thu hoi\n            A--&gt;&gt;C: Xoa cookie va tra ket qua\n            C--&gt;&gt;U: Chuyen ve trang dang nhap\n        else Khong hop le\n            A--&gt;&gt;C: Tu choi va xoa cookie\n        end\n\n    else Nguoi dung doi mat khau\n        U-&gt;&gt;C: Nhap mat khau cu va moi\n        C-&gt;&gt;A: POST /api/auth/change-password + CSRF\n        A-&gt;&gt;DB: Kiem tra session va tai khoan\n        DB--&gt;&gt;A: Thong tin tai khoan\n        A-&gt;&gt;A: Xac minh mat khau cu\n        A-&gt;&gt;A: Kiem tra mat khau moi it nhat 15 ky tu\n\n        alt Xac thuc va du lieu hop le\n            A-&gt;&gt;A: Bam mat khau moi bang Argon2id\n            A-&gt;&gt;DB: Cap nhat hash va thu hoi ALL sessions\n            A-&gt;&gt;DB: Ghi audit log\n            DB--&gt;&gt;A: Transaction COMMIT\n            A-&gt;&gt;S: Ngat tat ca socket cua user\n            A--&gt;&gt;C: Xoa cookie va yeu cau dang nhap lai\n            C--&gt;&gt;U: Hien thi trang dang nhap\n        else Khong hop le\n            A--&gt;&gt;C: Tu choi thay doi mat khau\n        end\n\n    else Quan tri vien khoa tai khoan\n        ADM-&gt;&gt;C: Chon tai khoan can khoa\n        C-&gt;&gt;A: POST /api/admin/users/:id/lock + CSRF\n        A-&gt;&gt;DB: Kiem tra session va vai tro ADMIN\n        DB--&gt;&gt;A: Ket qua phan quyen\n\n        alt Admin hop le\n            A-&gt;&gt;DB: Khoa user va thu hoi ALL sessions\n            A-&gt;&gt;DB: Ghi audit log\n            DB--&gt;&gt;A: Transaction COMMIT\n            A-&gt;&gt;S: Ngat tat ca socket cua user bi khoa\n            A--&gt;&gt;C: Khoa tai khoan thanh cong\n            C--&gt;&gt;ADM: Cap nhat trang thai tai khoan\n        else Khong co quyen\n            A-&gt;&gt;DB: Ghi audit log tu choi\n            A--&gt;&gt;C: 403 Forbidden\n        end\n    end\n\n    Note over A,S: Moi API va Socket.IO event phai kiem tra session\n    Note over A,S: Session revoked khong duoc tiep tuc hoat dong\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="aBUJjjscRK8_PzPz_Us--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
