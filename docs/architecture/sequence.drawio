        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as User\n    participant C as React Client\n    participant A as Express Backend\n    participant DB as PostgreSQL\n\n    U-&gt;&gt;C: Nhap username va password\n    C-&gt;&gt;A: POST /api/auth/login\n    A-&gt;&gt;A: Kiem tra gioi han dang nhap\n\n    alt Vuot gioi han\n        A--&gt;&gt;C: 429 Too Many Requests\n        C--&gt;&gt;U: Thong bao thu lai sau\n    else Duoc phep thu\n        A-&gt;&gt;DB: Tim tai khoan theo username\n        DB--&gt;&gt;A: Thong tin tai khoan hoac khong tim thay\n        A-&gt;&gt;A: Xac minh Argon2id va trang thai\n\n        alt Sai thong tin hoac tai khoan bi khoa\n            A-&gt;&gt;DB: Ghi audit log that bai\n            A--&gt;&gt;C: 401 Thong bao loi chung\n            C--&gt;&gt;U: Dang nhap khong thanh cong\n        else Thong tin hop le\n            A-&gt;&gt;A: Tao session token ngau nhien\n            A-&gt;&gt;DB: Luu token hash va thoi han phien\n            DB--&gt;&gt;A: Session da luu\n            A-&gt;&gt;DB: Ghi audit log thanh cong\n            A--&gt;&gt;C: 200 va cookie Secure HttpOnly SameSite\n\n            alt Phai doi mat khau lan dau\n                C--&gt;&gt;U: Chuyen den trang doi mat khau\n            else Khong can doi mat khau\n                C--&gt;&gt;U: Chuyen den trang Chat\n            end\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="bi6L9Pp1kTmbqtBYCl7d-1">
