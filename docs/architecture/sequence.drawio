  <diagram id="ch_02SendGroupMessage" name="02_Send_Group_Message">
    <mxGraphModel dx="2140" dy="3132" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2140" pageHeight="3132" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="group_02_Send_Group_Message" label="" mermaidData="{&quot;data&quot;: &quot;\nsequenceDiagram\n    autonumber\n    actor U as Nguoi gui\n    participant C as Frontend (React)\n    participant S as Backend (Express.js)\n    participant DB as Database (PostgreSQL)\n    actor R as Thanh vien nhom\n\n    U-&gt;&gt;C: Nhap va gui tin nhan\n    C-&gt;&gt;C: Tao client_msg_id duy nhat\n    C-&gt;&gt;S: Emit message:send\n\n    S-&gt;&gt;DB: Kiem tra session va user\n    DB--&gt;&gt;S: Trang thai phien va tai khoan\n\n    alt Session khong hop le\n        S--&gt;&gt;C: Tu choi va yeu cau dang nhap lai\n    else Session hop le\n        S-&gt;&gt;S: Kiem tra CSRF/Origin va rate limit\n        S-&gt;&gt;S: Validate payload: conversation_id, content/type hop le, noi dung khong rong va toi da 4000 ky tu\n\n        alt Yeu cau khong hop le\n            S--&gt;&gt;C: Tu choi yeu cau\n        else Yeu cau hop le\n            S-&gt;&gt;DB: Kiem tra group ton tai, dang hoat dong va sender la thanh vien hien tai\n            DB--&gt;&gt;S: Membership va joined_at left_at\n\n            alt Khong co quyen gui\n                S-&gt;&gt;DB: Ghi audit log tu choi\n                S--&gt;&gt;C: Loi FORBIDDEN\n            else Co quyen gui\n                S-&gt;&gt;DB: BEGIN transaction\n                S-&gt;&gt;DB: Kiem tra client_msg_id theo (sender_id, client_msg_id) va doi chieu conversation_id\n\n                alt DB/transaction thanh cong\n                    alt Tin nhan da ton tai va cung conversation_id\n                        DB--&gt;&gt;S: Tra ve tin da luu\n                        S-&gt;&gt;DB: COMMIT\n                        S--&gt;&gt;C: ACK tin nhan cu\n                    else client_msg_id da ton tai o conversation khac\n                        S-&gt;&gt;DB: COMMIT\n                        S--&gt;&gt;C: 409 Conflict (client_msg_id da dung o conversation khac)\n                    else Tin nhan moi\n                        S-&gt;&gt;DB: Kiem tra lai quyen va INSERT message voi UNIQUE(sender_id, client_msg_id) + ON CONFLICT de tranh trung tin khi retry\n                        DB--&gt;&gt;S: Tin nhan da luu\n                        S-&gt;&gt;DB: COMMIT\n                        DB--&gt;&gt;S: Thanh cong\n                        S--&gt;&gt;C: ACK gui thanh cong kem message_id, client_msg_id, created_at va status\n                        S-&gt;&gt;DB: Lay nguoi nhan con quyen\n                        DB--&gt;&gt;S: Danh sach thanh vien hop le\n                        S-&gt;&gt;R: Emit message:new\n                    end\n                else DB/transaction loi truoc COMMIT\n                    S-&gt;&gt;DB: ROLLBACK\n                    S--&gt;&gt;C: ACK gui that bai\n                end\n            end\n        end\n    end\n&quot;, &quot;config&quot;: {&quot;theme&quot;: &quot;dark&quot;}, &quot;version&quot;: &quot;final-readable&quot;}">
          <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;" vertex="1" parent="1">
            <mxGeometry x="0" y="0" width="2140" height="3132.0" as="geometry"/>
          </mxCell>
        </UserObject>
