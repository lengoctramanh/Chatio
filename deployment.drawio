  <diagram name="Trang-1" id="U4uSyudYWuV9a3-rvXwg">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle uml2\nskinparam rectangle {\n    BackgroundColor LightApplication\n    BorderColor DarkSlateGray\n}\n\ntitle Deployment Diagram - Chatio System Infrastructure\n\nnode \&quot;Client Device (User PC)\&quot; as ClientNode {\n    [Browser (React + Vite SPA)] as Browser\n}\n\nnode \&quot;Docker Host / Application Server\&quot; as ServerNode {\n    \n    node \&quot;Nginx Container\&quot; as ProxyNode {\n        [Reverse Proxy / SSL Termination] as Proxy\n    }\n    \n    node \&quot;Node.js Application Container\&quot; as AppNode {\n        [Chatio Backend (Node.js LTS + Express 5)] as Backend\n        [Socket.IO Server] as SocketServer\n        [Session &amp; Security Enforcement] as SecModule\n    }\n    \n    node \&quot;PostgreSQL Container (Internal Docker Network)\&quot; as DBNode {\n        database \&quot;PostgreSQL DB Engine\&quot; as DB {\n            [chatio_app_user (Least Privilege)] as DBUser\n        }\n    }\n    \n    node \&quot;Backup Worker Container / Cronjob\&quot; as BackupNode {\n        [Daily Backup Script] as BackupScript\n    }\n\n    folder \&quot;Host Volumes (Outside Webroot)\&quot; as Storage {\n        [uploads/ (Safe File Storage - No Exec)] as FileStorage\n        [logs/ (Append-Only Audit Logs)] as LogStorage\n        [keys/ (Master Encryption Keys)] as KeyStorage\n        [backups/ (Encrypted Backup Archive)] as BackupStorage\n    }\n}\n\n&#39; Connections\nBrowser --&gt; Proxy : HTTPS (Port 443)\\n[SEC-02: Secure/HttpOnly Cookies]\nBrowser --&gt; Proxy : WSS (WebSocket Secure)\\n[Realtime Chat]\n\nProxy --&gt; Backend : HTTP (Internal Bridge)\nProxy --&gt; SocketServer : WS (Internal Bridge)\n\nBackend --&gt; DBUser : Parameterized Query\\n[SEC-04: Anti SQLi]\nSocketServer --&gt; DBUser : Verify Rights &amp; Store Msg\n\nBackend --&gt; FileStorage : Save/Read Files (GUID Name)\\n[SEC-05: Magic Bytes Checked]\nBackend --&gt; LogStorage : Write Security Events\\n[SEC-07: No Secrets in Logs]\nBackend --&gt; KeyStorage : Access Encryption Keys\\n[SEC-06: Keys Separate from Code/DB]\n\nBackupScript --&gt; DB : Export Data\nBackupScript --&gt; FileStorage : Read Files\nBackupScript --&gt; KeyStorage : Read Master Key\nBackupScript --&gt; BackupStorage : Write Encrypted Archive\\n[SEC-09: Retention 7 Days]\n\nnote right of DBNode\n  &lt;b&gt;SEC-06: Database Security&lt;/b&gt;\n  - Accessible ONLY from backend container\n  - App user has minimal permissions\n  - Data at rest encrypted\nend note\n\nnote right of FileStorage\n  &lt;b&gt;SEC-05: File Handling&lt;/b&gt;\n  - Stored outside webroot\n  - Script execution disabled\n  - Max 10MB/file, 200MB/user\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TZWZ-WaEDxFOd09RJZSB-2">
