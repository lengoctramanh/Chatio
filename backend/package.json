  "main": "index.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:create": "node-pg-migrate create -m database/migrations",
    "db:migrate": "node-pg-migrate up -m database/migrations --envPath ../.env",
