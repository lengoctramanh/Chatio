PG_ADMIN_PASSWORD=your_admin_password
PG_APP_PASSWORD=your_app_password
DATABASE_URL=postgresql://chatio_app:your_url_encoded_app_password@localhost:5432/chatio

# Khóa ký CSRF token, tối thiểu 32 ký tự ngẫu nhiên.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=replace_with_random_32_plus_chars

# Chỉ đặt false khi chạy thử qua HTTP không phải localhost (ví dụ IP LAN). Mặc định true.
# COOKIE_SECURE=true

# Tùy chọn (giá trị mặc định theo SRS)
# SESSION_IDLE_MINUTES=15
# SESSION_ABSOLUTE_HOURS=8
# LOGIN_LIMIT_WINDOW_MINUTES=15
# LOGIN_LIMIT_PER_ACCOUNT=5
# LOGIN_LIMIT_PER_IP=20

# CSDL riêng cho test (tên phải kết thúc bằng _test, test sẽ xóa dữ liệu trong đó)
TEST_DATABASE_URL=postgresql://postgres:your_url_encoded_admin_password@localhost:5432/chatio_test
